                      "version": "v0",
                      "datasource": {
                        "name": "fg31bozhr629sa"
                      },
                      "spec": {
                        "dataset": "solarbi",
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "WITH horas AS (\r\n  SELECT generate_series(\r\n           date_trunc('hour', $__timeFrom()::timestamptz),\r\n           date_trunc('hour', $__timeTo()::timestamptz),\r\n           interval '1 hour') AS ts\r\n),\r\nsim AS (\r\n  SELECT h.ts, m.maquina_key, m.codigo_linea,\r\n         CASE WHEN EXTRACT(hour FROM h.ts) BETWEEN 6  AND 13 THEN 1\r\n              WHEN EXTRACT(hour FROM h.ts) BETWEEN 14 AND 21 THEN 2\r\n              ELSE 3 END AS turno,\r\n         ROUND((100 * (0.70 + 0.35 * abs(sin(EXTRACT(epoch FROM h.ts) / 3600.0 * m.maquina_key))))::numeric, 1) AS pacas\r\n  FROM horas h\r\n  CROSS JOIN dim_maquina m\r\n)\r\nSELECT ts AS \"time\", codigo_linea AS metric, pacas AS pacas_producidas\r\nFROM sim\r\nWHERE maquina_key IN ($maquina)\r\n  AND turno IN ($turno)\r\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
